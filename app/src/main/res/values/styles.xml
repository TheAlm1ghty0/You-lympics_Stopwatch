<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- This is the only style needed for the stopwatch app's dropdown menu -->
    <style name="CustomExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <!-- Color for the floating label text -->
        <item name="hintTextColor">@color/text_input_layout_colors</item>
        <!-- Color for the outline -->
        <item name="boxStrokeColor">@color/text_input_layout_colors</item>
        <!-- Background color of the dropdown box -->
        <item name="boxBackgroundColor">#404040</item>
        <!-- Color for the initial hint text before it floats -->
        <item name="android:textColorHint">#D3D3D3</item>
    </style>
</resources>
